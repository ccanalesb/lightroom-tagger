# Backend API Configuration
# Copy this file to .env. It is read by `node --env-file`, which `make dev` passes.
#
# Relative paths resolve against the REPO ROOT, not this directory
# (see REPO_ROOT in src/config.ts). The Flask backend resolved them against its
# own working directory, so paths carried over from its .env need adjusting.

# REQUIRED: Path to the main library database (created by `scan` command)
# Use absolute path, not relative
LIBRARY_DB=/path/to/your/library.db

# OPTIONAL: Ollama HTTP API base URL (vision matching via Ollama)
OLLAMA_HOST=http://localhost:11434

# OPTIONAL: NVIDIA NIM API key for cloud vision models
# Get your key from https://build.nvidia.com/
# NVIDIA_NIM_API_KEY=nvapi-your-key-here

# OPTIONAL: OpenCode Go API key for low-cost coding models
# Get your key from https://opencode.ai/go
# OPENCODE_GO_API_KEY=sk-your-key-here

# OPTIONAL: Path to visualizer-specific database (auto-created)
DATABASE_PATH=apps/visualizer/visualizer.db

# Server settings. The FLASK_ names are the ones the Flask backend used and are
# kept so an existing .env keeps working.
FLASK_HOST=localhost
# NOTE: On macOS, port 5000 is used by AirPlay Receiver. Use 5001 instead.
FLASK_PORT=5001
FLASK_DEBUG=true

# Frontend URLs for CORS (comma-separated)
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Directories
INSTAGRAM_DIR=/tmp/instagram_images
THUMBNAIL_DIR=apps/visualizer/thumbnails
